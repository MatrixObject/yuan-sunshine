<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>Sunshine Window Controller</AssemblyTitle>
    <RootNamespace>SunshineWindowController</RootNamespace>
    <ApplicationIcon>1up.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="1up.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    Focus-spoof injection binaries. Built with the MinGW toolchain from
    ../focusspoof. 64-bit pair: g++ -shared focusspoof.cpp -> focusspoof.dll,
    gcc -O2 injector.c -> injectedll.exe. 32-bit pair (for WOW64 games such
    as Doom 3 BFG): g++ -m32 ... -> focusspoof32.dll, gcc -m32 ... ->
    injectedll32.exe. FocusSpoof picks the pair matching the target process
    bitness, so both are copied next to the controller.

    The DLLs MUST be linked with -static (e.g.
    g++ -shared -O2 -s focusspoof.cpp -o focusspoof.dll -static -lws2_32 -lole32 -loleaut32
    and the -m32 variant with -Wl,--kill-at). Otherwise they hard-import the
    MinGW runtime (libstdc++-6.dll via new(std::nothrow) in the WMI shim, and
    libwinpthread-1.dll) which is not shipped, so the game process's
    LoadLibraryW fails and injection silently does nothing off the build box.
    With -static the only imports are system DLLs.
  -->
  <ItemGroup>
    <None Include="..\focusspoof\focusspoof.dll" CopyToOutputDirectory="PreserveNewest" Link="focusspoof.dll" />
    <None Include="..\focusspoof\injectedll.exe" CopyToOutputDirectory="PreserveNewest" Link="injectedll.exe" />
    <None Include="..\focusspoof\focusspoof32.dll" CopyToOutputDirectory="PreserveNewest" Link="focusspoof32.dll" />
    <None Include="..\focusspoof\injectedll32.exe" CopyToOutputDirectory="PreserveNewest" Link="injectedll32.exe" />
  </ItemGroup>
</Project>