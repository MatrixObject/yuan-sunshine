<Window x:Class="SunshineWindowController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunshine 窗口控制器"
        Height="700" Width="900"
        MinHeight="450" MinWidth="650"
        Background="#FF1E1E1E"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.Resources>
            <Style x:Key="DarkTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="#FF2D2D30"/>
                <Setter Property="BorderBrush" Value="#FF555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="DarkTabItem" TargetType="TabItem">
                <Setter Property="Background" Value="#FF2D2D30"/>
                <Setter Property="Foreground" Value="#FFCFCFCF"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0"
                                    Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DarkEditableComboBox" TargetType="ComboBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#FF3F3F46"/>
                <Setter Property="BorderBrush" Value="#FF555555"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2"/>
                                <TextBox x:Name="PART_EditableTextBox" Background="Transparent" Foreground="White"
                                         BorderThickness="0" Padding="6,4" VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"/>
                                <ToggleButton x:Name="Toggle" Width="22" HorizontalAlignment="Right" Margin="0,1,1,1"
                                              Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Data="M 0,0 L 5,5 L 10,0 Z" Fill="#FFCFCFCF" Stroke="#FFCFCFCF"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="#FF2D2D30" BorderBrush="#FF555555" BorderThickness="1"
                                            MinWidth="{TemplateBinding ActualWidth}" Margin="0,1,0,0">
                                        <ScrollViewer MaxHeight="240">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#FF0E639C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#FF2D2D30"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="6,5">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF0E639C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="#FFCFCFCF"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <TabControl Style="{StaticResource DarkTabControl}" SelectedIndex="0">
            <!-- ========== 设置标签页 ========== -->
            <TabItem Header="设置" Style="{StaticResource DarkTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- 连接设置 -->
                        <TextBlock Text="连接设置" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Border Background="#FF2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="sunshine.exe 路径：" Foreground="#FFCFCFCF" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="SunshinePathBox" Margin="8,0,0,0"
                                              IsEditable="True" Style="{StaticResource DarkEditableComboBox}"
                                              ToolTip="选择 sunshine.exe 路径。留空则仅控制已运行的 Sunshine。"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Web UI 地址：" Foreground="#FFCFCFCF" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="BaseUrlBox" Margin="8,0,0,0"
                                             Foreground="White" Background="#FF3F3F46" BorderThickness="0"
                                             Text="https://localhost:47990" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="用户名 / 密码：" Foreground="#FFCFCFCF" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="UsernameBox" Width="120" Margin="0,0,8,0"
                                                 Foreground="White" Background="#FF3F3F46" BorderThickness="0" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="PasswordBox" Width="120"
                                                     Foreground="White" Background="#FF3F3F46" BorderThickness="0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 焦点伪造选项 -->
                        <TextBlock Text="焦点伪造选项" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Border Background="#FF2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="BlockKbMouseCheck" Tag="BlockKeyboardMouse"
                                          Content="屏蔽键鼠输入（XInput 手柄始终有效）"
                                          Foreground="#FFCFCFCF" IsChecked="False" Margin="0,0,0,6"
                                          Checked="FocusOption_Changed" Unchecked="FocusOption_Changed"/>
                                <CheckBox x:Name="RawInputCheck" Tag="DisableRawInput"
                                          Content="禁用 Raw Input 钩子（默认关——屏蔽键鼠靠它，开着才生效）"
                                          Foreground="#FFCFCFCF" IsChecked="False" Margin="0,0,0,6"
                                          Checked="FocusOption_Changed" Unchecked="FocusOption_Changed"/>
                                <CheckBox x:Name="BlockLegacyMessagesCheck" Tag="BlockLegacyMessages"
                                          Content="窗口过程层屏蔽（需子类化，re9 上默认关以避免闪退）"
                                          Foreground="#FFCFCFCF" IsChecked="False" Margin="0,0,0,6"
                                          Checked="FocusOption_Changed" Unchecked="FocusOption_Changed"/>
                                <CheckBox x:Name="SuspendOnPatchCheck" Tag="SuspendThreadsOnPatch"
                                          Content="打补丁时冻结线程"
                                          Foreground="#FFCFCFCF" IsChecked="True" Margin="0,0,0,6"
                                          Checked="FocusOption_Changed" Unchecked="FocusOption_Changed"/>
                                <CheckBox x:Name="EnableSubclassCheck" Tag="EnableSubclass"
                                          Content="启用窗口子类化（旧方式，多数游戏建议关闭）"
                                          Foreground="#FFCFCFCF" IsChecked="False" Margin="0,0,0,6"
                                          Checked="FocusOption_Changed" Unchecked="FocusOption_Changed"/>
                                <CheckBox x:Name="BlockCursorHideCheck" Tag="BlockCursorHide"
                                          Content="阻止游戏隐藏鼠标（Hook ShowCursor）"
                                          Foreground="#FFCFCFCF" IsChecked="True" Margin="0,0,0,6"
                                          Checked="FocusOption_Changed" Unchecked="FocusOption_Changed"/>
                                <CheckBox x:Name="BlockCursorLockCheck" Tag="BlockCursorLock"
                                          Content="阻止游戏锁定鼠标（Hook ClipCursor/GetClipCursor）"
                                          Foreground="#FFCFCFCF" IsChecked="True" Margin="0,0,0,6"
                                          Checked="FocusOption_Changed" Unchecked="FocusOption_Changed"/>

                                <CheckBox x:Name="DisableAllCheck" Tag="DisableFocusSpoof"
                                          Content="禁用全部（仅加载 DLL）"
                                          Foreground="#FFCFCFCF" IsChecked="False" Margin="0,0,0,6"
                                          Checked="FocusOption_Changed" Unchecked="FocusOption_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 启动按钮 -->
                        <Button x:Name="LaunchButton" Content="启动 Sunshine" Padding="12,5"
                                Click="LaunchButton_Click" Background="#FF3E7C17" Foreground="White" BorderThickness="0"
                                HorizontalAlignment="Left" Width="140" Margin="0,0,0,8"/>

                        <!-- 配置保存/加载 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button x:Name="SaveConfigButton" Content="保存配置" Padding="12,5"
                                    Click="SaveConfigButton_Click" Background="#FF0E639C" Foreground="White" BorderThickness="0"/>
                            <Button x:Name="LoadConfigButton" Content="加载配置" Padding="12,5" Margin="8,0,0,0"
                                    Click="LoadConfigButton_Click" Background="#FF0E639C" Foreground="White" BorderThickness="0"/>
                            <TextBlock Text="保存/加载全部焦点伪造选项到配置文件" Foreground="#FF8A8A8A"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- 状态 -->
                        <TextBlock x:Name="StatusText" Text="就绪。" Foreground="#FFCFCFCF"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 录制目标标签页 ========== -->
            <TabItem Header="录制目标" Style="{StaticResource DarkTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="TargetCountText" Text="共找到 0 个窗口" Foreground="#FFCFCFCF" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshButton" Content="刷新" Margin="24,0,0,0"
                                Padding="12,5" Click="RefreshButton_Click"
                                Background="#FF0E639C" Foreground="White" BorderThickness="0"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="TargetList"
                             Background="#FF252526" Foreground="White"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TargetList_SelectionChanged"
                             PreviewMouseLeftButtonDown="TargetList_PreviewMouseLeftButtonDown"
                             ItemsSource="{Binding Targets}">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="#FF252526" BorderThickness="0" Padding="2">
                                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="false">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#FF252526" CornerRadius="4"
                                                    BorderThickness="0" SnapsToDevicePixels="true">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF3E3E42"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF0E639C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" Background="#FF333337" CornerRadius="4" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="160" Height="90" Background="#FF1E1E1E"
                                                BorderBrush="#FF555555" BorderThickness="1">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="White" FontWeight="Bold"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" Foreground="#FFCFCFCF" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Name="FocusSpoofButton"
                                                Content="{Binding FocusButtonText}"
                                                Click="FocusSpoofButton_Click"
                                                Padding="12,7" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Foreground="White" BorderThickness="0"
                                                ToolTip="为该窗口注入焦点伪造 DLL，使其在后台也保持渲染与手柄响应。">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                                                                <Condition Binding="{Binding CanFocusSpoof}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="#FF3E3E42"/>
                                        <Setter TargetName="Card" Property="BorderBrush" Value="#FF555555"/>
                                        <Setter TargetName="Card" Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="#FF0E639C"/>
                                        <Setter TargetName="Card" Property="BorderBrush" Value="#FF54B4FF"/>
                                        <Setter TargetName="Card" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                                        <Setter TargetName="SubtitleText" Property="Foreground" Value="#FFE8E8E8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFocusSpoofOn}" Value="True">
                                        <Setter TargetName="FocusSpoofButton" Property="Background" Value="#FFB23A2E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFocusSpoofOn}" Value="False">
                                        <Setter TargetName="FocusSpoofButton" Property="Background" Value="#FF3E7C17"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="点击窗口只切换 Sunshine 录制目标（点击桌面切回全屏）；点击窗口右侧按钮才会注入/卸载焦点伪造。"
                               Foreground="#FF8A8A8A" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
